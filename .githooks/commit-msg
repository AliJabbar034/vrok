#!/bin/sh
# Rejects a commit subject the release automation cannot read.
#
# This is not a style rule. The version number is computed from these
# prefixes, so an unparseable subject is a release that silently does not
# happen.

set -eu

. "$(dirname "$0")/lib.sh"

subject=$(sed -n '1p' "$1")

# Merges, reverts, fixups and squashes are generated by git itself.
case "$subject" in
Merge\ * | Revert\ * | fixup!* | squash!* | Applying\ *) exit 0 ;;
esac

# An empty message aborts the commit anyway; let git say so.
[ -z "$subject" ] && exit 0

if printf '%s' "$subject" | grep -qE "$CONVENTIONAL_COMMIT_RE"; then
	# A subject that runs past ~72 characters is truncated in git log, on
	# GitHub, and in the release notes.
	length=$(printf '%s' "$subject" | wc -c | tr -d ' ')
	if [ "$length" -gt 72 ]; then
		warn "subject is $length characters; it will be truncated at 72"
		printf '    %s\n' "$subject"
	fi
	exit 0
fi

fail "the commit subject is not a conventional commit" \
	"" \
	"  got:  $subject" \
	"" \
	"  feat: add a thing         -> next minor   (1.4.2 -> 1.5.0)" \
	"  fix: correct a thing      -> next patch   (1.4.2 -> 1.4.3)" \
	"  feat!: remove a flag      -> next major   (1.4.2 -> 2.0.0)" \
	"  docs: explain a thing     -> no release" \
	"" \
	"  Types:  $COMMIT_TYPES" \
	"  Scopes are optional:  fix(server): ..." \
	"" \
	"To commit anyway: git commit --no-verify"
