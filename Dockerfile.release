# Image built by GoReleaser dockers_v2. The binary is already cross-compiled
# and staged under linux/amd64/ and linux/arm64/; TARGETPLATFORM selects
# which one this architecture of the image should copy. Do not COPY from the
# context root — that is the legacy dockers layout and is why v0.1.1 failed.
#
# The multi-stage Dockerfile at the repository root is the one that builds
# from source (`docker build .`).

FROM gcr.io/distroless/static:nonroot

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/vrok-relay /vrok-relay

# The relay stores nothing and needs no writable filesystem.
USER nonroot:nonroot

EXPOSE 8787

ENV VROK_RELAY_ADDR=:8787

ENTRYPOINT ["/vrok-relay"]
